generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 유저 
// ==========================================

enum UserRole {
  USER // 일반 사용자
  STAFF // 직원
  ADMIN // 관리자
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String?
  nickname     String   @unique
  profileImage String?
  bio          String?
  role         UserRole @default(USER)

  provider String? //  'GOOGLE', 'APPLE','LOCAL' 등
  socialId String? // 소셜 서비스에서 제공하는 유저의 고유 ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pushToken String? @map("push_token")

  termsAgreedAt     DateTime? // 서비스 이용약관 동의 일시
  privacyAgreedAt   DateTime? // 개인정보 처리방침 동의 일시
  marketingAgreedAt DateTime? // 마케팅 수신 동의 일시 (선택)

  crisisReports     CrisisReport[] // 내가 작성한 위기 제보 목록
  hostedCommunities CommunityPost[]   @relation("AuthoredCommunities") // 내가 방장으로 생성한 모임 목록
  joinedCommunities CommunityMember[] // 내가 참가자로 들어간 모임
  chatMessages      ChatMessage[] // 내가 전송한 커뮤니티 채팅 메시지

  aiConsultings  AiConsulting[] // 내 AI 상담 내역
  crisisComments CrisisComment[]

  sentReports     Report[] @relation("ReportReporter")
  receivedReports Report[] @relation("ReportedUser")

  blockerList Block[] @relation("BlockerRelation")
  blockedList Block[] @relation("BlockedRelation")

  @@unique([provider, socialId])
}

// ==========================================
// 제보 탭
// ==========================================

enum CrisisStatus {
  PENDING // 제보 접수
  IN_PROGRESS // 조치 진행 중
  RESOLVED // 조치 완료
}

model CrisisReport {
  id        String       @id @default(uuid())
  title     String
  content   String
  address   String // 도로명 주소
  latitude  Float? // 위기 발생 위치 (위도)
  longitude Float? // 위기 발생 위치 (경도)
  images    String[] // 제보 이미지 URL
  status    CrisisStatus @default(PENDING)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  comments CrisisComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model CrisisComment {
  id      String @id @default(uuid())
  content String

  // 제보글과의 관계 (1:N)
  reportId String
  report   CrisisReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // 작성자와의 관계 (1:N)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportId])
  @@index([userId])
}

// ==========================================
// 상담 탭 (FastAPI 연동)
// ==========================================

model AiConsulting {
  id       String @id @default(uuid())
  question String // 유저 질문
  answer   String // AI 상담 응답 (FastAPI 처리 결과)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ==========================================
// 모임 탭 
// ==========================================

enum CommunityType {
  VOLUNTEER // 봉사활동
  SELF_HELP // 자조모임
}

model CommunityPost {
  id         String        @id @default(uuid())
  type       CommunityType
  title      String
  content    String
  images     String[]
  maxMembers Int?
  notice     String?

  hostId String
  host   User   @relation("AuthoredCommunities", fields: [hostId], references: [id], onDelete: Cascade)

  chatMessages ChatMessage[]
  members      CommunityMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

enum CommunityMemberStatus {
  PENDING // 승인 대기중
  APPROVED // 승인됨
  BANNED // 강퇴됨 
}

model CommunityMember {
  id String @id @default(uuid())

  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status   CommunityMemberStatus @default(PENDING)
  joinedAt DateTime              @default(now())

  @@unique([postId, userId])
}

model ChatMessage {
  id      String @id @default(uuid())
  message String

  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ==========================================
// 신고하기 
// ==========================================

enum ReportReason {
  SPAM // 불법 광고 및 도배
  INAPPROPRIATE // 부적절한 콘텐츠
  ABUSE // 욕설, 비방, 혐오 발언
  IMPERSONATION // 사칭 및 허위 정보
  OTHER // 기타
}

enum ReportStatus {
  PENDING // 처리 대기 중
  RESOLVED // 제재 완료
  DISMISSED // 무효 기각 
}

model Report {
  id String @id @default(uuid())

  reporterId String?
  reporter   User?   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  reportedUserId String?
  reportedUser   User?   @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  reason  ReportReason
  details String
  status  ReportStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reporterId, reportedUserId, reason])
  @@index([status])
  @@index([reportedUserId])
}

// ==========================================
// 차단하기 
// ==========================================

model Block {
  id String @id @default(uuid())

  // 차단을 실행한 유저
  blockerId String
  blocker   User   @relation("BlockerRelation", fields: [blockerId], references: [id], onDelete: Cascade)

  // 차단당한 유저 
  blockedId   String
  blockedUser User   @relation("BlockedRelation", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // 복합 유니크 제약: 동일 유저를 중복 차단할 수 없도록 보장
  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}
